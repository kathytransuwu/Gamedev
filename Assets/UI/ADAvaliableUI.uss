.stamina-container {
    position: absolute;
    bottom: 40px;
    left: 40px;
    width: 300px;
}

.stamina-label {
    color: white;
    font-size: 14px;
    margin-bottom: 4px;
}

.stamina-bar-bg {
    width: 100%;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 9px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.stamina-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(80, 220, 100);
    border-radius: 9px;
    transition-property: width;
    transition-duration: 0.15s;
}
#Reticle {
    position: absolute;
    top: 50%;
    left: 50%;
    margin-left: -15px;
    margin-top: -15px;
    width: 30px;
    height: 30px;
    background-color: rgba(0,0,0,0);
    overflow: visible;
}
#crosshair-horizontal {
    position: absolute;
    width: 20px;
    height: 2px;
    top: 9px;
    left: 0px;
    background-color: white;
}
#crosshair-vertical {
    position: absolute;
    width: 2px;
    height: 20px;
    left: 9px;
    top: 0px;
    background-color: white;
}